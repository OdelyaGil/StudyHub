{
  "expo": {
    "name": "StudyHub",
    "slug": "study-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.studyhub.app"
    },
    "android": {
      "package": "com.studyhub.app"
    },
    "web": { "bundler": "metro" },
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-document-picker",
        {
          "photosPermission": "Allow StudyHub to access your files.",
          "documentPickerPermission": "Allow StudyHub to pick documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StudyHub to access your photos to set a profile picture."
        }
      ]
    ]
  }
}
