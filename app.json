{
  "expo": {
    "name": "StudyHub",
    "slug": "study-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#FFFFFF",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.studyhub.app"
    },
    "android": {
      "package": "com.studyhub.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon.png",
      "themeColor": "#FF8C42",
      "backgroundColor": "#FFFFFF"
    },
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-document-picker",
        {
          "photosPermission": "Allow StudyHub to access your files.",
          "documentPickerPermission": "Allow StudyHub to pick documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StudyHub to access your photos to set a profile picture."
        }
      ]
    ]
  }
}
