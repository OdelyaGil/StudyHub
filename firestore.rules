rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!('name'            in request.resource.data) || request.resource.data.name            is string)
        && (!('email'           in request.resource.data) || request.resource.data.email           is string)
        && (!('accent'          in request.resource.data) || request.resource.data.accent          is string)
        && (!('mode'            in request.resource.data) || request.resource.data.mode            is string)
        && (!('requiredCredits' in request.resource.data) || request.resource.data.requiredCredits is number);

      // Subcollection: large fields (tasks, grades, schedule, photoURL, etc.) are
      // stored here so each gets its own 1 MB budget. Each document must have
      // exactly one field named 'value' to prevent arbitrary schema injection.
      match /store/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['value']);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
