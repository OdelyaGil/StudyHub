rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollection: large array fields (tasks, grades, schedule, etc.) are
      // stored here so each gets its own 1 MB budget instead of competing
      // inside a single user document.
      match /store/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
